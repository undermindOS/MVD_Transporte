<?xml version="1.0" encoding="utf-8"?>
<!-- One bus on a stop widget (Parada, Mis paradas): line in a dim amber
     outline, destination, accessible mark, clock and "~20:14". An estimate:
     the time is never amber. TimbreStopWidget adds one per bus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Between rows, not above the first -->
    <ImageView
        android:id="@+id/w_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@color/linea_noche" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_row_line"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_badge_lit_bg"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="46dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/ambar"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_row_dest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/papel"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/w_row_acc"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_accessible"
            android:visibility="gone" />

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_clock_dim" />

        <TextView
            android:id="@+id/w_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-condensed"
            android:minWidth="46dp"
            android:gravity="end"
            android:textColor="@color/papel"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
