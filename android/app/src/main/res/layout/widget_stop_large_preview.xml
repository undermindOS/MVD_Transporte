<?xml version="1.0" encoding="utf-8"?>
<!-- Stop widget Mis paradas (4 × 4): two stops, three buses each, and the links to Mi STM and Recarga. Picker preview with sample data. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- Unlit LEDs behind the header, as on the app bar -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_led_band" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- The TIMBRE MVD plate and the refresh button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Timbre MVD"
                android:scaleType="fitStart"
                android:src="@drawable/widget_plate" />

            <!-- 44 dp touch target over an 18 dp icon -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-12dp"
                android:layout_marginBottom="-8dp"
                android:contentDescription="Actualizar"
                android:padding="13dp"
                android:src="@drawable/widget_ic_refresh" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_stop" />

                    <!-- Name and, smaller, " · 574" (spans) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="SAN JOSE y ANDES · 574"
                        android:textColor="@color/papel"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge_lit_bg"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="121"
                        android:textColor="@color/ambar"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="PUNTA CARRETAS"
                        android:textColor="@color/papel"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_accessible" />
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_clock_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="end"
                        android:minWidth="46dp"
                        android:text="~20:14"
                        android:textColor="@color/papel"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no"
                    android:src="@color/linea_noche"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge_lit_bg"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="538"
                        android:textColor="@color/ambar"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="BUCEO"
                        android:textColor="@color/papel"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_clock_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="end"
                        android:minWidth="46dp"
                        android:text="~20:16"
                        android:textColor="@color/papel"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no"
                    android:src="@color/linea_noche"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge_lit_bg"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="144"
                        android:textColor="@color/ambar"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="CEMENTERIO DEL NORTE"
                        android:textColor="@color/papel"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_clock_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="end"
                        android:minWidth="46dp"
                        android:text="~20:17"
                        android:textColor="@color/papel"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@color/linea_noche" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_stop" />

                    <!-- Name and, smaller, " · 574" (spans) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="AV RAMON ANADOR y TIBURCIO GOMEZ · 3140"
                        android:textColor="@color/papel"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge_lit_bg"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="145"
                        android:textColor="@color/ambar"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="BV ARTIGAS Y BV ESPAÑA"
                        android:textColor="@color/papel"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_accessible" />
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_clock_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="end"
                        android:minWidth="46dp"
                        android:text="~20:18"
                        android:textColor="@color/papel"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no"
                    android:src="@color/linea_noche"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge_lit_bg"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="494"
                        android:textColor="@color/ambar"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="DELTA DEL TIGRE (POR COMPEN)"
                        android:textColor="@color/papel"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_clock_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="end"
                        android:minWidth="46dp"
                        android:text="~20:23"
                        android:textColor="@color/papel"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:importantForAccessibility="no"
                    android:src="@color/linea_noche"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_badge_lit_bg"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="143"
                        android:textColor="@color/ambar"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:text="CIUDADELA"
                        android:textColor="@color/papel"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_clock_dim" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="end"
                        android:minWidth="46dp"
                        android:text="~20:31"
                        android:textColor="@color/papel"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_warning"
                android:visibility="gone" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Datos de las 20:13"
                android:textColor="@color/tenue"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_button_bg"
                android:drawableEnd="@drawable/widget_ic_external"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="Mi STM"
                android:textColor="@color/ambar"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button_bg"
                android:drawableEnd="@drawable/widget_ic_external"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="Recarga"
                android:textColor="@color/ambar"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
