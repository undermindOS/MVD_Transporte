<?xml version='1.0' encoding='utf-8'?>
<!-- Próximo ancho (4 × 2): the clock of Próximo, larger, with the day and the stop beside it; the next bus and the two after it below. TimbreAnchoWidget fills it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="1dp" android:layout_marginTop="1dp" android:layout_marginEnd="1dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_led_band" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <!-- The time in lit LEDs over unlit ones; "9:05" sits right. The mask makes the digits dots, the negative margins trim the room the font keeps above and below digits -->
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="-9dp" android:layout_marginBottom="-14dp" android:foreground="@drawable/widget_clock_mask_large" android:foregroundGravity="fill">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:importantForAccessibility="no" android:includeFontPadding="false" android:text="@string/widget_clock_unlit" android:textColor="@color/reloj_apagado" android:textSize="64sp" android:textStyle="bold" />
                <TextClock android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:fontFamily="sans-serif-condensed" android:format12Hour="h:mm" android:format24Hour="H:mm" android:includeFontPadding="false" android:shadowColor="@color/reloj_brillo" android:shadowRadius="12" android:textColor="@color/ambar" android:textSize="64sp" android:textStyle="bold" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextClock android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-condensed" android:format12Hour="EEEE d MMM" android:format24Hour="EEEE d MMM" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/etiqueta" android:textSize="12sp" android:textStyle="bold" />
                <!-- With saved stops: the stop, tap for the next one -->
                <LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_stop" />
                    <TextView android:id="@+id/w_stop_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="sans-serif-condensed" android:maxLines="2" android:textColor="@color/papel" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/w_board" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <!-- The next bus: an estimate, clock and "~", not amber -->
                <LinearLayout android:id="@+id/w_next_bus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/w_line" android:layout_width="wrap_content" android:layout_height="30dp" android:background="@drawable/widget_badge_lit_bg" android:fontFamily="sans-serif-condensed" android:gravity="center" android:maxLines="1" android:minWidth="54dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="@color/ambar" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/w_dest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-condensed" android:maxLines="2" android:textColor="@color/papel" android:textSize="16sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/w_acc" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="6dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_accessible" android:visibility="gone" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="10dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_clock_dim" />
                    <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="sans-serif-condensed" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/papel" android:textSize="24sp" android:textStyle="bold" />
                </LinearLayout>
                <!-- The two after it: "538 ~20:16 · 144 ~20:17", lines in amber -->
                <TextView android:id="@+id/w_after" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:textColor="@color/etiqueta" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:textColor="@color/etiqueta" android:textSize="14sp" android:visibility="gone" />
                <FrameLayout android:id="@+id/w_spacer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/w_footer_icon" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_warning" android:visibility="gone" />
                    <TextView android:id="@+id/w_footer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/tenue" android:textSize="11sp" />
                    <ImageView android:id="@+id/w_refresh" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="-8dp" android:layout_marginEnd="-12dp" android:layout_marginBottom="-8dp" android:contentDescription="Actualizar" android:padding="13dp" android:src="@drawable/widget_ic_refresh" />
                </LinearLayout>
            </LinearLayout>
            <!-- No saved stops: the clock stays, the sign of the app's empty list under it -->
            <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_led_field" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
                <ImageView android:layout_width="wrap_content" android:layout_height="18dp" android:adjustViewBounds="true" android:contentDescription="Sin paradas" android:src="@drawable/widget_sin_paradas" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2" android:text="Agregá una parada en Mis paradas para verla acá." android:textColor="@color/etiqueta" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
