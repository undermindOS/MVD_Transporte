<?xml version="1.0" encoding="utf-8"?>
<!-- Stop widget Próximo (2 × 2): a clock on top, then one stop, its next bus and the two after it. TimbreProximoWidget fills it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <!-- Unlit LEDs behind the clock, as on the app bar -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_led_band" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- The clock: the time in lit amber LEDs over unlit ones, and
             the day. TextClock keeps itself current, with no update from
             the app; also with no saved stops -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The mask over it makes the digits lit dots; the negative
                 margins trim the room the font keeps above and below digits -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="-9dp"
                android:foreground="@drawable/widget_clock_mask"
                android:foregroundGravity="fill">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/widget_clock_unlit"
                    android:textColor="@color/reloj_apagado"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <!-- "9:05" sits right, over the last digits: the first one stays unlit -->
                <TextClock
                    android:id="@+id/w_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:fontFamily="sans-serif-condensed"
                    android:format12Hour="h:mm"
                    android:format24Hour="H:mm"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/reloj_brillo"
                    android:shadowRadius="10"
                    android:textColor="@color/ambar"
                    android:textSize="42sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:format12Hour="EEE"
                    android:format24Hour="EEE"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/etiqueta"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:format12Hour="d"
                    android:format24Hour="d"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/papel"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/w_board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Small: the name alone takes the whole width -->
                <LinearLayout
                    android:id="@+id/w_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_stop" />

                    <TextView
                        android:id="@+id/w_stop_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/papel"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- The next bus: line and its time on one line, the
                     destination under them. An estimate: "~", not amber -->
                <LinearLayout
                    android:id="@+id/w_next_bus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/w_line"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="@drawable/widget_badge_lit_bg"
                            android:fontFamily="sans-serif-condensed"
                            android:gravity="center"
                            android:maxLines="1"
                            android:minWidth="46dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="@color/ambar"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/w_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-condensed"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/papel"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/w_acc"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_ic_accessible"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/w_dest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:textColor="@color/papel"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- The two after it: "538 ~20:16 · 144 ~20:17", lines in amber -->
                <TextView
                    android:id="@+id/w_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="1"
                    android:textColor="@color/etiqueta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- "Sin próximos ómnibus…" or "Sin datos recientes" -->
                <TextView
                    android:id="@+id/w_message"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/etiqueta"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/w_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/w_footer_icon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_warning"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/w_footer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/tenue"
                        android:textSize="11sp" />

                    <!-- 44 dp touch target over an 18 dp icon -->
                    <ImageView
                        android:id="@+id/w_refresh"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="-8dp"
                        android:layout_marginEnd="-12dp"
                        android:layout_marginBottom="-8dp"
                        android:contentDescription="Actualizar"
                        android:padding="13dp"
                        android:src="@drawable/widget_ic_refresh" />

                </LinearLayout>

            </LinearLayout>

            <!-- No saved stops: the clock stays, the sign of the app's empty list under it -->
            <LinearLayout
                android:id="@+id/w_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_led_field"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Sin paradas"
                    android:src="@drawable/widget_sin_paradas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="Agregá una parada en Mis paradas para verla acá."
                    android:textColor="@color/etiqueta"
                    android:textSize="12sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
