<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="1dp" android:layout_marginTop="1dp" android:layout_marginEnd="1dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_led_band" />
    <LinearLayout android:id="@+id/w_board" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/w_header" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_stop" />
                <TextView android:id="@+id/w_stop_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="sans-serif-condensed" android:textColor="@color/papel" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <ImageView android:id="@+id/w_refresh" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="-8dp" android:layout_marginEnd="-12dp" android:layout_marginBottom="-8dp" android:contentDescription="Actualizar" android:padding="13dp" android:src="@drawable/widget_ic_refresh" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/w_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:textColor="@color/etiqueta" android:textSize="14sp" android:visibility="gone" />
        <FrameLayout android:id="@+id/w_spacer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_footer_icon" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_warning" android:visibility="gone" />
            <TextView android:id="@+id/w_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/tenue" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="6dp" android:background="@drawable/widget_led_field" android:gravity="center" android:orientation="vertical" android:padding="10dp" android:visibility="gone">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" android:src="@drawable/widget_ic_bus" />
        <ImageView android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginTop="8dp" android:adjustViewBounds="true" android:contentDescription="Sin paradas" android:src="@drawable/widget_sin_paradas" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:maxLines="3" android:text="Agregá una parada en Mis paradas para verla acá." android:textColor="@color/etiqueta" android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>