<?xml version="1.0" encoding="utf-8"?>
<!-- Stop widget (docs/design/10-superficies.md). Data comes from the app;
     updatePeriodMillis only redraws, so buses that passed drop out -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="320dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="320dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_stop_large"
    android:previewLayout="@layout/widget_stop_large_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_mis_paradas_description" />
